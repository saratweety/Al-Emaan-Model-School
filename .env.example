# Supabase project URL and publishable (anon) key — safe to expose to the browser.
# Find these in Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service_role secret — server-only, never expose to the browser.
# Used for admin actions: creating teacher/parent logins, deleting users, resetting passwords.
# Find it in Supabase Dashboard → Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# ZKTeco K40 fingerprint device — used only by `npm run attendance:sync`.
# IP: on the device, Menu > Comm > Ethernet. Give it a static/reserved IP on your router.
ZK_DEVICE_IP=
ZK_DEVICE_PORT=4370

# Shared secret the ESP32 + R307 fingerprint device sends with every check-in
# to /api/device-checkin. Generate any long random string and put the same
# value in the ESP32 firmware's DEVICE_SECRET constant.
DEVICE_SHARED_SECRET=
